{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["renovate", "dependencies"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "argocd": {
    "fileMatch": ["apps/.*/Application\\.yaml$"]
  },
  "kubernetes": {
    "fileMatch": ["apps/.*/manifests/.*\\.yaml$", "apps/.*/values\\.yaml$"]
  },
  "packageRules": [
    {
      "description": "Do not track :latest tag. matchCurrentValue (not matchCurrentVersion) is required for non-semver raw string matching; matchCurrentVersion only works with semver ranges. Renovate v36+ config migration.",
      "matchCurrentValue": "^latest$",
      "enabled": false
    },
    {
      "description": "Zabbix proxy — floating *-latest tag",
      "matchPackageNames": ["zabbix/zabbix-proxy-sqlite3"],
      "enabled": false
    },
    {
      "description": "ARC runner image — własny obraz, rebuildowany co tydzień",
      "matchPackageNames": ["ghcr.io/majowka/arc-runner"],
      "enabled": false
    }
  ]
}
